# ============================================================
# MongoDB Atlas
# ============================================================

MONGO_URL=
MONGO_DB=
MONGO_COLLECTION=


# ============================================================
# LLM providers
# ============================================================

# OpenAI
OPENAI_API_KEY=

# OpenRouter
# OpenRouter provides access to models from multiple providers
# through an OpenAI-compatible API.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1


# Optional providers
# Uncomment/add the corresponding key if the application
# is configured to use a model from that provider directly.

ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=


# ============================================================
# Embeddings
# ============================================================

# Optional Hugging Face token for embedding models
HUGGINGFACEHUB_API_TOKEN=

# Hugging Face Inference API endpoint
EMBEDDING_URL=https://api-inference.huggingface.co/pipeline/feature-extraction/sentence-transformers/all-MiniLM-L6-v2


# ============================================================
# LangSmith / LangChain tracing
# ============================================================

LANGCHAIN_TRACING_V2=true
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=Scn1_ROS2


# ============================================================
# LangChain Hub
# ============================================================

LANGCHAIN_HUB_API_KEY=
LANGCHAIN_HUB_API_URL=https://api.hub.langchain.com
